---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { titulo?: string; descripcion?: string; imagen?: string }
const {
  titulo,
  descripcion = 'Más de un centenar de librerías independientes de referencia en más de 60 ciudades. Revista L, promociones y la red de librerías asociadas.',
  imagen,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} · Librerías Independientes` : 'Librerías Independientes · La red de librerías de referencia';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    {imagen && <meta property="og:image" content={imagen} />}
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f7f2e9" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body>
    <div class="aviso-demo"><strong>Versión de demostración</strong> · Propuesta de nueva web preparada por Leran AI</div>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
