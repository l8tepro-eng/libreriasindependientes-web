---
import Base from '../layouts/Base.astro';
import Visor from '../components/Visor.astro';
import RevistaCard from '../components/RevistaCard.astro';
import Mapa from '../components/Mapa.astro';
import { getRevistas, getLibrerias, url, nombreTemporada } from '../lib/data.mjs';

const revistas = await getRevistas();
const librerias = await getLibrerias();
const castellano = revistas.filter((r) => r.idioma === 'es');
const ultima = castellano[0] ?? revistas[0];
const catalana = ultima && revistas.find((r) => r.idioma === 'ca' && r.numero === ultima.numero);
const recientes = castellano.slice(1, 5);
const ciudades = new Set(librerias.map((l) => (l.ciudad || '').toLowerCase()).filter(Boolean)).size;
const comunidades = new Set(librerias.map((l) => l.comunidad).filter(Boolean)).size;

const lomos = [
  {
    tejuelo: 'I',
    titulo: 'Quiénes somos',
    dato: 'Desde 1997',
    texto: 'Un proyecto que engloba a más de un centenar de librerías de referencia en más de 60 ciudades de todo el territorio nacional. Nació para defender la diversidad cultural y crear una marca de prestigio basada en la calidad del servicio al cliente.',
    enlace: '/quienes-somos',
    accion: 'Leer más',
  },
  {
    tejuelo: 'II',
    titulo: 'Qué hacemos',
    dato: 'Central de compras y servicios',
    texto: 'Coordinamos la compra centralizada de novedades y promociones, negociamos con editoriales y distribuidoras, pagamos a proveedores y llevamos la gestión administrativa. Una sola voz ante el sector, con el peso de más de cien librerías.',
    enlace: '/quienes-somos',
    accion: 'Ver los servicios',
  },
  {
    tejuelo: 'III',
    titulo: 'Las librerías',
    dato: `${librerias.length} librerías · ${ciudades} ciudades · ${comunidades} comunidades`,
    texto: 'Librerías independientes de referencia por toda España, cada una con sus particularidades. En el mapa puedes buscar la tuya por nombre, ciudad o comunidad y ver su ficha con dirección y contacto.',
    enlace: '/asociados',
    accion: 'Ver el mapa',
  },
  {
    tejuelo: 'IV',
    titulo: 'Únete a la red',
    dato: 'Para libreros',
    texto: 'Compras centralizadas, mejores condiciones con editoriales y distribuidoras, cuatro números al año de la Revista L para repartir entre tus clientes y una comunidad de más de cien libreros.',
    enlace: '/asociacion-libreros',
    accion: 'Solicitar información',
  },
];
---
<Base imagen={ultima?.portada}>
  <!-- ESTANTERÍA -->
  <section class="apertura">
    <div class="contenedor">
      <h1 class="lema">Más de cien librerías <em>de referencia</em></h1>
      <p class="entradilla apertura__entradilla">Desde 1997, la red que reúne a las librerías independientes de España. Abre un lomo para saber quiénes somos y qué hacemos.</p>

      <div class="estanteria">
        {lomos.map((l, i) => (
          <button class="lomo" aria-expanded="false" data-lomo data-indice={i}>
            <span class="lomo__vertical">{l.titulo}</span>
            <span class="lomo__tejuelo">{l.tejuelo}</span>
            <span class="lomo__contenido">
              <span class="lomo__dato">{l.dato}</span>
              <span class="lomo__titulo">{l.titulo}</span>
              <span class="lomo__texto">{l.texto}</span>
              <a class="lomo__enlace" href={url(l.enlace)}>{l.accion} →</a>
            </span>
          </button>
        ))}
      </div>
      <div class="balda"></div>
    </div>
  </section>

  <!-- REVISTA -->
  {ultima && (
    <section class="seccion seccion--oscura" id="leer">
      <div class="contenedor">
        <div class="cabecera-seccion">
          <div>
            <span class="antetitulo">Revista L · Nuevo número</span>
            <h2>{ultima.titulo}</h2>
            <p class="entradilla entradilla--clara">{ultima.descripcion || 'Las novedades y recomendaciones de los libreros independientes, en papel en más de cien librerías y aquí, para leer en línea.'}</p>
          </div>
          <div class="cabecera-seccion__acciones">
            <a class="boton" href={url('/revista-l')}>Todas las revistas <span class="flecha">→</span></a>
            {catalana && <a class="boton boton--claro boton--sobre-oscuro" href={url(`/revista-l/${catalana.slug}`)}>Versió en català</a>}
          </div>
        </div>

        <div class="solo-escritorio">
          <Visor pdf={ultima.pdfVisor} titulo={ultima.titulo} portada={ultima.portada} descarga={ultima.pdf} />
        </div>

        <div class="revista-movil solo-movil">
          {ultima.portada && <img src={ultima.portada} alt={`Portada de ${ultima.titulo}`} width="420" height="588" />}
          <a class="boton" href={url(`/revista-l/${ultima.slug}`)}>Leer la revista <span class="flecha">→</span></a>
        </div>
      </div>
    </section>
  )}

  <!-- ARCHIVO RECIENTE -->
  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <div>
          <span class="antetitulo">Cuatro números al año</span>
          <h2>Una revista para cada estación</h2>
          <p class="entradilla">Primavera, verano, otoño y Navidad: la selección de los libreros llega cada temporada, en castellano y en catalán.</p>
        </div>
        <a class="boton boton--claro" href={url('/revista-l')}>Ver el archivo completo <span class="flecha">→</span></a>
      </div>
      <div class="rejilla-revistas">
        {recientes.map((r) => <RevistaCard revista={r} />)}
      </div>
    </div>
  </section>

  <!-- MAPA -->
  <section class="seccion seccion--crema">
    <div class="contenedor mapa-home">
      <div>
        <span class="antetitulo">La red</span>
        <h2>Hay una librería independiente cerca de ti</h2>
        <p class="entradilla">{librerias.length} librerías de referencia en {ciudades} ciudades. Libreros de verdad, que leen, recomiendan y hacen barrio.</p>
        <a class="boton" href={url('/asociados')}>Buscar mi librería <span class="flecha">→</span></a>
      </div>
      <Mapa librerias={librerias} compacto />
    </div>
  </section>
</Base>

<script>
  const lomos = document.querySelectorAll<HTMLButtonElement>('[data-lomo]');
  lomos.forEach((lomo) => {
    lomo.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.lomo__enlace')) return;
      const abierto = lomo.getAttribute('aria-expanded') === 'true';
      lomos.forEach((otro) => otro.setAttribute('aria-expanded', 'false'));
      lomo.setAttribute('aria-expanded', abierto ? 'false' : 'true');
    });
  });
</script>

<style>
  .apertura { padding: clamp(36px, 5vw, 64px) 0 clamp(48px, 6vw, 80px); }
  .lema { margin-bottom: .3em; max-width: 18ch; }
  .lema em { font-family: var(--serif); font-style: italic; color: var(--acento); }
  .apertura__entradilla { margin-bottom: 44px; max-width: 52ch; }

  .estanteria { display: flex; gap: 10px; height: 460px; align-items: stretch; }
  .balda { height: 12px; background: linear-gradient(var(--madera), #6d5138); border-radius: 0 0 3px 3px; box-shadow: 0 10px 18px -14px rgba(0,0,0,.6); }

  .lomo {
    position: relative; flex: 0 0 86px; border: 0; padding: 0; cursor: pointer; overflow: hidden; text-align: left;
    border-radius: 3px 3px 0 0; font-family: var(--serif-display); color: #1c1a17;
    transition: flex-basis .45s cubic-bezier(.22,.7,.25,1), flex-grow .45s cubic-bezier(.22,.7,.25,1);
    box-shadow: inset -6px 0 12px -8px rgba(0,0,0,.45), inset 6px 0 10px -9px rgba(255,255,255,.35), 0 6px 14px -10px rgba(0,0,0,.45);
  }
  .lomo:nth-child(1) { background: var(--lomo-1); color: #1b2118; }
  .lomo:nth-child(2) { background: var(--lomo-2); color: #f6f3ec; }
  .lomo:nth-child(3) { background: var(--lomo-3); color: #2a120c; }
  .lomo:nth-child(4) { background: var(--lomo-4); box-shadow: inset -6px 0 12px -9px rgba(0,0,0,.3), inset 0 0 0 1px rgba(28,26,23,.14), 0 6px 14px -10px rgba(0,0,0,.4); }
  .lomo::before, .lomo::after { content: ""; position: absolute; left: 10px; right: 10px; height: 1px; background: currentColor; opacity: .35; }
  .lomo::before { top: 26px; }
  .lomo::after { bottom: 26px; }

  .lomo__vertical {
    position: absolute; inset: 0; display: grid; place-items: center;
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-size: 1.24rem; letter-spacing: .02em; padding: 44px 0; transition: opacity .25s;
  }
  .lomo__tejuelo { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); font-family: var(--sans); font-size: .62rem; letter-spacing: .12em; opacity: .7; }

  .lomo__contenido {
    opacity: 0; visibility: hidden; height: 100%; display: flex; flex-direction: column; justify-content: center;
    gap: 14px; padding: 44px 40px; transition: opacity .3s .12s;
  }
  .lomo__titulo { font-family: var(--serif-display); font-size: clamp(1.7rem, 2.6vw, 2.3rem); line-height: 1.08; }
  .lomo__texto { font-family: var(--serif); font-size: 1.02rem; line-height: 1.5; max-width: 48ch; }
  .lomo__dato { font-family: var(--sans); font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  .lomo__enlace { font-family: var(--sans); font-size: .93rem; font-weight: 600; color: inherit; align-self: start; text-underline-offset: 4px; }

  .lomo[aria-expanded="true"] { flex: 1 1 auto; cursor: default; }
  .lomo[aria-expanded="true"] .lomo__vertical { opacity: 0; visibility: hidden; }
  .lomo[aria-expanded="true"] .lomo__contenido { opacity: 1; visibility: visible; }

  .cabecera-seccion { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 44px; }
  .cabecera-seccion h2 { margin-bottom: .3em; }
  .cabecera-seccion__acciones { display: flex; gap: 12px; flex-wrap: wrap; }
  .entradilla--clara { color: #cfc6b8; }
  .boton--sobre-oscuro { background: transparent; color: var(--papel); border-color: var(--papel); }
  .boton--sobre-oscuro:hover { background: var(--papel); color: var(--tinta); }

  .revista-movil { display: none; flex-direction: column; align-items: center; gap: 22px; }
  .revista-movil img { max-width: 280px; border-radius: 3px; box-shadow: 0 20px 40px -26px rgba(0,0,0,.8); }

  .rejilla-revistas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .mapa-home { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: center; }
  .mapa-home .entradilla { margin-bottom: 1.6em; }

  .solo-movil { display: none; }

  @media (max-width: 900px) {
    .mapa-home { grid-template-columns: 1fr; }
    .rejilla-revistas { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .estanteria { height: 420px; }
  }
  @media (max-width: 760px) {
    .solo-escritorio { display: none !important; }
    .solo-movil { display: block; }
    .revista-movil { display: flex; }
    .estanteria { flex-direction: column; height: auto; gap: 8px; }
    .balda { display: none; }
    .lomo { flex: 0 0 auto; border-radius: 3px; min-height: 66px; }
    .lomo__vertical { writing-mode: horizontal-tb; transform: none; place-items: center start; padding: 0 22px; font-size: 1.15rem; }
    .lomo::before { top: 0; bottom: auto; left: 0; right: 0; height: 2px; opacity: .25; }
    .lomo::after { display: none; }
    .lomo__tejuelo { bottom: auto; top: 50%; left: auto; right: 18px; transform: translateY(-50%); }
    .lomo__contenido { padding: 26px 22px; }
  }
</style>
