---
interface Props { claro?: boolean }
const { claro = false } = Astro.props;
---
<span class:list={['logo', { 'logo--claro': claro }]}>
  <span class="logo__l" aria-hidden="true">L</span>
  <span class="logo__texto">Librerías<br />Independientes</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: .6rem; color: var(--tinta); }
  .logo__l {
    font-family: var(--serif); font-style: italic; font-weight: 600; font-size: 2.1rem; line-height: 1;
    width: 2.6rem; height: 2.6rem; display: grid; place-items: center; border-radius: 10px;
    background: var(--acento); color: var(--papel); padding-bottom: .15rem;
  }
  .logo__texto { font-family: var(--serif); font-size: 1.02rem; line-height: 1.05; font-weight: 500; letter-spacing: -.005em; }
  .logo--claro { color: var(--papel); }
</style>
