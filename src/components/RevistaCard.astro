---
import { url, nombreTemporada } from '../lib/data.mjs';
interface Props { revista: any; grande?: boolean }
const { revista: r, grande = false } = Astro.props;
---
<article class:list={['tarjeta', { 'tarjeta--grande': grande }]} data-anio={r.anio} data-temporada={r.temporada} data-idioma={r.idioma}>
  <a href={url(`/revista-l/${r.slug}`)} class="tarjeta__enlace">
    <div class="tarjeta__portada">
      {r.portada ? <img src={r.portada} alt={`Portada de ${r.titulo}`} loading="lazy" decoding="async" width="400" height="560" /> : <div class="tarjeta__sin">L</div>}
    </div>
    <div class="tarjeta__meta">
      <span class:list={['etiqueta', `etiqueta--${r.temporada}`]}>{nombreTemporada(r)}{r.anio ? ` ${r.anio}` : ''}</span>
      {r.idioma === 'ca' && <span class="etiqueta etiqueta--ca">Català</span>}
    </div>
    <h3 class="tarjeta__titulo">{r.numero ? `Nº ${r.numero}` : r.titulo}</h3>
    {r.subtitulo && <p class="tarjeta__sub">{r.subtitulo}</p>}
  </a>
</article>
<style>
  .tarjeta__enlace { text-decoration: none; display: block; }
  .tarjeta__portada {
    aspect-ratio: 5 / 7; background: var(--papel-2); overflow: hidden; border-radius: 3px;
    box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 10px 24px -12px rgba(40,25,10,.35);
    transition: transform .35s cubic-bezier(.2,.7,.3,1), box-shadow .35s;
  }
  .tarjeta__portada img { width: 100%; height: 100%; object-fit: cover; }
  .tarjeta__enlace:hover .tarjeta__portada { transform: translateY(-6px) rotate(-.6deg); box-shadow: 0 2px 4px rgba(0,0,0,.08), 0 22px 40px -16px rgba(40,25,10,.45); }
  .tarjeta__sin { height: 100%; display: grid; place-items: center; font-family: var(--serif); font-size: 5rem; font-style: italic; color: var(--acento); }
  .tarjeta__meta { display: flex; gap: 6px; flex-wrap: wrap; margin: 14px 0 6px; }
  .tarjeta__titulo { font-size: 1.2rem; margin: 0; }
  .tarjeta__sub { font-size: .85rem; color: var(--tinta-2); margin: 2px 0 0; text-transform: uppercase; letter-spacing: .04em; }
  .tarjeta--grande .tarjeta__titulo { font-size: 1.6rem; }
</style>
